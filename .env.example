# Copy to .env to override the defaults shown here.

# Address and port the web interface is served on. 0.0.0.0 makes it reachable from the LAN.
RADIOBENCH_HTTP_HOST=0.0.0.0
RADIOBENCH_HTTP_PORT=81

# The interface is also served over HTTPS, which browsers need before they allow the
# microphone. The certificate is made by the server itself; see the README.
RADIOBENCH_HTTPS=on
RADIOBENCH_HTTPS_PORT=444

# CAT serial port: "auto" finds the FT-710's Enhanced COM Port, "sim" runs the
# built-in simulator, anything else is used as the port name (e.g. COM3).
RADIOBENCH_CAT_PORT=auto

# "auto" tries each rate the radio offers until it answers. To skip the search, give the
# rate set under MENU > OPERATION SETTING > GENERAL > CAT-1 RATE on the radio (e.g. 38400).
RADIOBENCH_CAT_BAUD=auto
RADIOBENCH_CAT_STOP_BITS=2

# "on" lets clients put the radio on the air: MOX, VOX, antenna tuning, CW and voice memories,
# and microphone audio. See the README.
RADIOBENCH_TX=off

# The radio's audio: "on" or "off". The names are matched against part of the names Windows
# gives the radio's sound device, for recording (its received audio) and playback (its
# transmit audio).
RADIOBENCH_AUDIO=on
RADIOBENCH_AUDIO_IN=USB Audio Device
RADIOBENCH_AUDIO_OUT=USB Audio Device

# FT8/FT4 monitor: how hard the decoder tries, as WSJT-X's 1 (fast), 2 (normal) or 3 (deep).
# Deep takes about two seconds of all the PC's cores after every slot.
RADIOBENCH_DECODE_DEPTH=3

# Spectrum scope: "on" or "off". It needs SCU-LAN10 set to ON on the radio, and FTDI's
# LibFT4222-64.dll in apps/server/vendor (see the README there) or wherever this points.
RADIOBENCH_SCOPE=on
# RADIOBENCH_FT4222_DLL=C:\path\to\LibFT4222-64.dll
