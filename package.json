{
  "name": "radiobench",
  "version": "0.1.0",
  "private": true,
  "description": "PC and LAN web front panel for the Yaesu FT-710",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w @radiobench/server\" \"npm run dev -w @radiobench/web\"",
    "dev:sim": "concurrently -k -n server,web -c blue,green \"npm run dev:sim -w @radiobench/server\" \"npm run dev -w @radiobench/web\"",
    "build": "npm run build -w @radiobench/web",
    "build:all": "npm run build --workspaces --if-present",
    "start": "npm run start -w @radiobench/server",
    "start:sim": "npm run start:sim -w @radiobench/server",
    "desktop": "npm run build:all && npm run start -w @radiobench/desktop",
    "package": "node scripts/package.mjs",
    "package:dir": "node scripts/package.mjs --dir",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "allowScripts": {
    "electron": true,
    "@kmamal/sdl": true,
    "koffi": true,
    "@serialport/bindings-cpp": true,
    "electron-winstaller": true
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
